# --- Motor de IA -----------------------------------------------------------
# Sin estas variables, la app usa un proveedor simulado (mock) con datos
# realistas: el loop completo funciona igualmente.

# Activa Gemini real:
# AI_PROVIDER=gemini

# Modo "studio": clave simple de Google AI Studio (arranque en 2 minutos).
# GEMINI_MODE=studio
# GEMINI_API_KEY=tu_api_key

# Modo "vertex": usa tus créditos de Google Cloud (Vertex AI).
# GEMINI_MODE=vertex
# GOOGLE_CLOUD_PROJECT=tu_proyecto
# GOOGLE_CLOUD_LOCATION=europe-west4

# Modelos (opcionales). Manténlos separados para poder controlar coste y calidad.
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_RESEARCH_MODEL=gemini-3.5-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Fallback local opcional (usa la GPU NVIDIA mediante Ollama):
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_VISION_MODEL=gemma3:4b

# --- Datos (futuro) --------------------------------------------------------
# Hoy se usa un adaptador local. Supabase se enchufa aquí sin tocar la app.
# TRIAJE_DATA_DIR=.data
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
